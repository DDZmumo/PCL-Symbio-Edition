<local:MyPageLeft x:Class="PCL.PageBedrockLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d" x:Name="PanBack"
                  Width="300" AnimatedControl="{Binding ElementName=PanSide, Mode=OneWay}">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>

        <!-- 账号与快捷操作 -->
        <local:MyScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Margin="20,0,10,0"
                              Style="{StaticResource ScrollViewerFullMargin}">
            <StackPanel x:Name="PanSide" Margin="0,12,0,0">

                <!-- 当前 Xbox 账号 -->
                <Border Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource ColorBrush3}" />
                            <TextBlock x:Name="LabAvatar" Text="?" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrushWhite}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LabGamertag" Text="{DynamicResource Bedrock.Account.Loading}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabAccountMail" Text="" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                        </StackPanel>
                        <local:MyIconButton Grid.Column="2" x:Name="BtnRefreshAccount"
                                            SvgIcon="lucide/refresh-cw" LogoScale="0.85"
                                            VerticalAlignment="Top"
                                            ToolTip="{DynamicResource Bedrock.Account.Refresh}"
                                            ToolTipService.Placement="Left"
                                            Click="RefreshAccount_Click" />
                    </Grid>
                </Border>
                <TextBlock x:Name="LabAccountHint" Visibility="Collapsed" Text="{DynamicResource Bedrock.Account.Hint}" />
                <local:MyButton x:Name="BtnSwitchAccount" Height="35" Margin="0,8,0,0"
                                ToolTip="{Binding Text, ElementName=LabAccountHint}"
                                Text="{DynamicResource Bedrock.Account.Switch}" Click="BtnSwitchAccount_Click" />

                <!-- 快捷操作 -->
                <TextBlock Text="{DynamicResource Bedrock.Shortcuts.Title}" Margin="13,10,5,4" Opacity="0.6" FontSize="12" />
                <local:MyListItem Height="36" VerticalAlignment="Top" IsScaleAnimationEnabled="False"
                                  Type="Clickable" Title="{DynamicResource Bedrock.Editor.Open}"
                                  SvgIcon="lucide/pencil" Click="OpenEditor_Click" />
                <local:MyListItem Height="36" VerticalAlignment="Top" IsScaleAnimationEnabled="False"
                                  Type="Clickable" Title="{DynamicResource Bedrock.Shortcuts.OpenSaves}"
                                  SvgIcon="lucide/folder-open" Click="OpenSavesFolder_Click" />
                <local:MyListItem Height="36" VerticalAlignment="Top" IsScaleAnimationEnabled="False"
                                  Type="Clickable" Title="{DynamicResource Bedrock.Shortcuts.OpenPackages}"
                                  SvgIcon="lucide/box" Click="OpenPackageFolder_Click" />
                <local:MyListItem Height="36" VerticalAlignment="Top" IsScaleAnimationEnabled="False"
                                  Type="Clickable" Title="{DynamicResource Bedrock.Shortcuts.OpenScreenshots}"
                                  SvgIcon="lucide/image" Click="OpenScreenshotFolder_Click" />
                <local:MyListItem Height="36" VerticalAlignment="Top" IsScaleAnimationEnabled="False"
                                  Type="Clickable" Title="{DynamicResource Bedrock.Shortcuts.OpenXbox}"
                                  SvgIcon="lucide/play" Click="OpenXboxApp_Click" />

            </StackPanel>
        </local:MyScrollViewer>

        <!-- 启动按钮 -->
        <Grid Grid.Row="1" Margin="0,10,0,0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Grid.RenderTransform>
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="{DynamicResource Bedrock.Action.Launch}" ColorType="Highlight"
                            Click="BtnLaunch_Click"
                            Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersionText" Text="{DynamicResource Bedrock.Status.NotSelected}" Margin="35,0,35,10"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" RenderTransformOrigin="0.5,-0.2">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="{Binding RealRenderTransform.ScaleX, ElementName=BtnLaunch, Mode=OneWay}"
                                    ScaleY="{Binding RealRenderTransform.ScaleY, ElementName=BtnLaunch, Mode=OneWay}" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</local:MyPageLeft>
