<local:MyPageRight x:Class="PCL.PageBedrockRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">

            <!-- 状态 -->
            <local:MyCard Title="{DynamicResource Bedrock.Status.Title}">
                <Grid Margin="25,38,23,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="ShapeStatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Fill="{DynamicResource ColorBrushGray4}" />
                            <TextBlock x:Name="LabStatus" Text="{DynamicResource Bedrock.Status.Detecting}"
                                       FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="LabDetail" Text="{DynamicResource Bedrock.Status.PleaseWait}"
                                   TextWrapping="Wrap" FontSize="12" Margin="16,0,0,5"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabVersion" Text=""
                                   FontSize="12" Margin="16,0,0,0"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                        <!-- 启动进度条：与 Java 版启动页一致，用两列宽度动画表示进度 -->
                        <Grid Name="PanLaunchProgress" Height="4" Margin="16,10,0,0"
                              SnapsToDevicePixels="True" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Name="ProgressBedrockFinished" Width="0*" />
                                <ColumnDefinition Name="ProgressBedrockUnfinished" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                        <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                                        <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <local:MyButton x:Name="BtnLaunch" Height="46" Text="{DynamicResource Bedrock.Action.Launch}"
                                        ColorType="Highlight" Click="BtnLaunch_Click"
                                        Padding="20,0,20,0" />
                        <TextBlock x:Name="LabSelectedVersion" Text="{DynamicResource Bedrock.Status.NotFound}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" />
                        <local:MyButton x:Name="BtnUpdate" Height="32" Text="{DynamicResource Bedrock.Action.UpdateToLatest}"
                                        ColorType="Normal" Click="BtnUpdate_Click"
                                        Padding="12,0,12,0" Margin="0,8,0,0"
                                        Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <!-- 已下载版本 -->
            <local:MyCard Margin="0,12,0,0" Title="{DynamicResource Bedrock.Local.Title}">
                <StackPanel Margin="15,38,15,15">
                    <Grid Margin="5,0,5,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{DynamicResource Bedrock.Local.Description}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <local:MyCheckBox Grid.Column="1" x:Name="CheckIsolation" Height="22"
                                          VerticalAlignment="Center" Margin="10,0,0,0"
                                          Text="{DynamicResource Bedrock.Isolation.Title}"
                                          ToolTip="{DynamicResource Bedrock.Isolation.Hint}"
                                          Change="CheckIsolation_OnChange" />
                        <local:MyButton Grid.Column="2" x:Name="BtnImport" Text="{DynamicResource Bedrock.Action.Import}"
                                        Height="30" Padding="14,0,14,0" Margin="10,0,0,0"
                                        Click="ImportPackage_Click" />
                    </Grid>
                    <StackPanel Name="PanLocalVersions" Margin="0,4,0,0" />
                </StackPanel>
            </local:MyCard>

            <!-- 搜索 -->
            <local:MySearchBox x:Name="SearchBox" Margin="0,12,0,0" HintText="{DynamicResource Bedrock.Search.Hint}" />

            <!-- 在线版本 -->
            <local:MyCard Margin="0,12,0,0" Title="{DynamicResource Bedrock.Download.Title}">
                <StackPanel Margin="15,38,15,15">
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                        <local:MyRadioButton x:Name="FilterAll" Text="{DynamicResource Bedrock.Filter.All}" ColorType="Highlight" Checked="True" />
                        <local:MyRadioButton x:Name="FilterUwp" Text="{DynamicResource Bedrock.Filter.Uwp}" ColorType="Highlight" Margin="8,0,0,0" />
                        <local:MyRadioButton x:Name="FilterGdk" Text="{DynamicResource Bedrock.Filter.Gdk}" ColorType="Highlight" Margin="8,0,0,0" />
                    </StackPanel>
                    <Grid Margin="5,0,0,6">
                        <TextBlock x:Name="LabVersionSummary" Text="{DynamicResource Bedrock.Download.Loading}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Bedrock.Download.SourceLabel}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                            <local:MyTextButton Text="mcappx.com" FontSize="12" Padding="2,0,2,0" Height="18"
                                                VerticalAlignment="Center"
                                                local:CustomEventService.EventType="OpenUrl"
                                                local:CustomEventService.EventData="https://www.mcappx.com/" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Name="PanVersionList" Margin="0,4,0,0" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
